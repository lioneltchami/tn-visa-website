# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI (for AI chatbot)
OPENAI_API_KEY=sk-your-openai-api-key

# Supabase Service Role (for content ingestion script only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (for newsletter emails)
RESEND_API_KEY=re_your-resend-api-key

# Stripe (for digital product sales)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Signs the download links emailed to buyers. Rotating it invalidates old links.
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
DOWNLOAD_TOKEN_SECRET=generate-with-openssl-rand-hex-32

# Base URL used in emails (defaults to https://tnvisaguide.ca)
NEXT_PUBLIC_SITE_URL=https://tnvisaguide.ca

# AI chat spend guardrails (optional — defaults shown)
CHAT_BURST_LIMIT=8
CHAT_IP_DAILY_LIMIT=40
CHAT_GLOBAL_DAILY_LIMIT=1200

# JSearch (for external job sync)
JSEARCH_API_KEY=your-rapidapi-key
JSEARCH_API_HOST=jsearch.p.rapidapi.com

# Job Sync + Renewal Reminder Authentication
# SYNC_SECRET: For manual triggers (curl -H "Authorization: Bearer $SYNC_SECRET")
# CRON_SECRET: For Vercel Cron (Vercel sends this automatically to both
#   /api/jobs/sync at 06:00 UTC and /api/renewal-reminders at 06:15 UTC)
# You can use the same value for both, or set them separately
SYNC_SECRET=generate-with-openssl-rand-hex-32
CRON_SECRET=generate-with-openssl-rand-hex-32

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional Organization sameAs profiles (comma-separated https URLs)
# NEXT_PUBLIC_ORG_SAME_AS=https://www.linkedin.com/company/example,https://x.com/example

# Affiliate tracking URLs (set after each program approves your account)
# Until set, links use ordinary non-commission destination URLs.
NEXT_PUBLIC_AFFILIATE_TNVISAEXPERT_SERVICES_URL=https://your-tracked-services-link
NEXT_PUBLIC_AFFILIATE_TNVISAEXPERT_INTERVIEW_URL=https://your-tracked-interview-link
NEXT_PUBLIC_AFFILIATE_TNVISAEXPERT_DENIED_URL=https://your-tracked-denial-help-link
NEXT_PUBLIC_AFFILIATE_WES_URL=https://your-tracked-wes-link
NEXT_PUBLIC_AFFILIATE_WISE_URL=https://your-tracked-wise-link